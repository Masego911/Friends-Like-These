import {
    useEffect,
    useRef,
    useState,
} from "react";

import type { Team } from "../../models/Team";
import TeamList from "../team/TeamList";
import "./Scoreboard.css";
import Countdown from "./Countdown";
import RegistrationQR from "./RegistrationQR";
import { eventConfig } from "../../config/eventConfig";
import type {
    GameRound,
    RoundStanding,
} from "../../api/roundsApi";

interface ScoreboardProps {
    teams: Team[];
    registrationDeadline: Date;
    rounds: GameRound[];
    roundStandings: RoundStanding[];
    registrationFormUrl?: string;
}

/*
 * ---------------------------------------------------------
 * Transition types
 * ---------------------------------------------------------
 */

type StartTransition = {
    type: "START";
    roundNumber: number;
};

type WinnerTransition = {
    type: "WINNER";
    roundNumber: number;
    teamName: string;
    score: number;
};

type TransitionState =
    | StartTransition
    | WinnerTransition
    | null;

function Scoreboard({
                        teams,
                        registrationDeadline,
                        rounds,
                        roundStandings,
                        registrationFormUrl,
                    }: ScoreboardProps) {

    /*
     * ---------------------------------------------------------
     * Current round
     * ---------------------------------------------------------
     */

    const activeRound =
        rounds.find(
            (round) =>
                round.status ===
                "IN_PROGRESS"
        );

    /*
     * Convert the round standings into Team objects so the
     * existing TeamList can render the live round leaderboard.
     */
    const roundTeams: Team[] =
        roundStandings.map(
            (standing) => ({
                id: standing.teamId,
                name: standing.teamName,
                members: [],
                score: standing.roundScore,
            })
        );

    /*
     * During an active round we display only that round's
     * points. Between rounds we display cumulative totals.
     */
    const displayedTeams =
        activeRound
            ? roundTeams
            : teams;

    /*
     * ---------------------------------------------------------
     * Remember the active round
     * ---------------------------------------------------------
     */

    const previousActiveRound =
        useRef<
            number | null | undefined
        >(undefined);

    /*
     * ---------------------------------------------------------
     * Preserve latest round standings
     * ---------------------------------------------------------
     *
     * When End Round is pressed the application changes back
     * to cumulative standings.
     *
     * We preserve the final live-round standings so the winner
     * celebration always uses the actual winner of that round,
     * not the cumulative overall leader.
     */

    const latestRoundStandingsRef =
        useRef<RoundStanding[]>([]);

    useEffect(() => {

        if (
            activeRound &&
            roundStandings.length > 0
        ) {

            latestRoundStandingsRef.current =
                [...roundStandings];
        }

    }, [
        activeRound?.roundNumber,
        roundStandings,
    ]);

    /*
     * ---------------------------------------------------------
     * Transition state
     * ---------------------------------------------------------
     */

    const [
        transition,
        setTransition,
    ] = useState<TransitionState>(
        null
    );

    /*
     * ---------------------------------------------------------
     * Overall standings reveal
     * ---------------------------------------------------------
     *
     * This becomes true only after the Round Winner screen
     * finishes.
     *
     * It is deliberately NOT connected to the one-second
     * polling cycle.
     */

    const [
        revealOverallStandings,
        setRevealOverallStandings,
    ] = useState(false);

    /*
     * A monotonically increasing key lets TeamList mount a new
     * reveal sequence after each completed round.
     *
     * Round 1 -> 1
     * Round 2 -> 2
     * Round 3 -> 3
     *
     * Polling does not change this value.
     */
    const [
        overallRevealKey,
        setOverallRevealKey,
    ] = useState(0);

    /*
     * ---------------------------------------------------------
     * Detect round start / round end
     * ---------------------------------------------------------
     */

    useEffect(() => {

        const currentRoundNumber =
            activeRound?.roundNumber ??
            null;

        /*
         * Initial page load.
         *
         * Remember the current state without creating a fake
         * transition when the public scoreboard is opened or
         * refreshed.
         */
        if (
            previousActiveRound.current ===
            undefined
        ) {

            previousActiveRound.current =
                currentRoundNumber;

            return;
        }

        const previousRoundNumber =
            previousActiveRound.current;

        /*
         * -----------------------------------------------------
         * ROUND START
         * -----------------------------------------------------
         */

        if (
            previousRoundNumber === null &&
            currentRoundNumber !== null
        ) {

            /*
             * We are entering live round mode, so any previous
             * overall reveal is finished.
             */
            setRevealOverallStandings(false);

            setTransition({
                type: "START",
                roundNumber:
                currentRoundNumber,
            });

            previousActiveRound.current =
                currentRoundNumber;

            const timer =
                window.setTimeout(
                    () => {

                        setTransition(null);

                    },
                    2200
                );

            return () => {

                window.clearTimeout(
                    timer
                );
            };
        }

        /*
         * -----------------------------------------------------
         * ROUND END
         * -----------------------------------------------------
         */

        if (
            previousRoundNumber !== null &&
            currentRoundNumber === null
        ) {

            /*
             * Do not reveal Overall Standings underneath the
             * winner celebration.
             */
            setRevealOverallStandings(false);

            /*
             * Use the preserved standings from the round that
             * just ended.
             */
            const completedStandings =
                latestRoundStandingsRef.current;

            /*
             * Sort a copy so API state is never mutated.
             */
            const sortedFinalStandings =
                [...completedStandings]
                    .sort(
                        (a, b) =>
                            b.roundScore -
                            a.roundScore
                    );

            const winner =
                sortedFinalStandings[0];

            if (winner) {

                setTransition({
                    type: "WINNER",
                    roundNumber:
                    previousRoundNumber,
                    teamName:
                    winner.teamName,
                    score:
                    winner.roundScore,
                });

            } else {

                /*
                 * Defensive fallback.
                 *
                 * If no round standings exist, do not invent
                 * a winner.
                 */
                setTransition(null);
            }

            previousActiveRound.current =
                currentRoundNumber;

            /*
             * -------------------------------------------------
             * WINNER -> OVERALL STANDINGS
             * -------------------------------------------------
             *
             * Winner celebration lasts 3.6 seconds.
             *
             * Only after it has completed do we trigger the
             * cumulative leaderboard reveal.
             */
            const timer =
                window.setTimeout(
                    () => {

                        setTransition(null);

                        setOverallRevealKey(
                            (current) =>
                                current + 1
                        );

                        setRevealOverallStandings(
                            true
                        );

                    },
                    3600
                );

            return () => {

                window.clearTimeout(
                    timer
                );
            };
        }

        previousActiveRound.current =
            currentRoundNumber;

    }, [activeRound?.roundNumber]);

    /*
     * ---------------------------------------------------------
     * Render
     * ---------------------------------------------------------
     */

    return (
        <section className="scoreboard">

            {/* ===============================================
                ROUND START
                =============================================== */}

            {transition?.type ===
                "START" && (

                    <div
                        className="
                        scoreboard-transition
                        scoreboard-transition--start
                    "
                        role="status"
                        aria-live="polite"
                    >

                        <div className="scoreboard-transition__colour-bar">
                            <span />
                            <span />
                            <span />
                            <span />
                            <span />
                        </div>

                        <div className="scoreboard-transition__content">

                        <span className="scoreboard-transition__eyebrow">
                            Friends Like These
                        </span>

                            <strong className="scoreboard-transition__round">
                                ROUND{" "}
                                {
                                    transition.roundNumber
                                }
                            </strong>

                            <span className="scoreboard-transition__status">
                            ROUND IN PROGRESS
                        </span>

                        </div>

                    </div>

                )}

            {/* ===============================================
                ROUND WINNER
                =============================================== */}

            {transition?.type ===
                "WINNER" && (

                    <div
                        className="
                        scoreboard-transition
                        scoreboard-transition--winner
                    "
                        role="status"
                        aria-live="assertive"
                    >

                        <div
                            className="scoreboard-winner__particles"
                            aria-hidden="true"
                        >
                            <span />
                            <span />
                            <span />
                            <span />
                            <span />
                            <span />
                            <span />
                            <span />
                            <span />
                            <span />
                        </div>

                        <div className="scoreboard-transition__colour-bar">
                            <span />
                            <span />
                            <span />
                            <span />
                            <span />
                        </div>

                        <div className="scoreboard-transition__content scoreboard-winner">

                        <span className="scoreboard-transition__eyebrow">
                            Friends Like These
                        </span>

                            <span className="scoreboard-winner__round">
                            ROUND{" "}
                                {
                                    transition.roundNumber
                                }
                        </span>

                            {/* ===================================
                            LARGE TROPHY
                            =================================== */}

                            <div
                                className="scoreboard-winner__trophy"
                                aria-hidden="true"
                            >
                                <svg
                                    viewBox="0 0 120 120"
                                    role="img"
                                >

                                    <path
                                        className="scoreboard-winner__trophy-cup"
                                        d="
                                        M38 18
                                        H82
                                        V39
                                        C82 57 73 68 64 72
                                        V84
                                        H76
                                        V94
                                        H44
                                        V84
                                        H56
                                        V72
                                        C47 68 38 57 38 39
                                        Z
                                    "
                                    />

                                    <path
                                        className="scoreboard-winner__trophy-handle"
                                        d="
                                        M38 26
                                        H22
                                        V37
                                        C22 50 30 57 43 58
                                    "
                                    />

                                    <path
                                        className="scoreboard-winner__trophy-handle"
                                        d="
                                        M82 26
                                        H98
                                        V37
                                        C98 50 90 57 77 58
                                    "
                                    />

                                    <path
                                        className="scoreboard-winner__trophy-base"
                                        d="
                                        M38 94
                                        H82
                                        V104
                                        H38
                                        Z
                                    "
                                    />

                                </svg>
                            </div>

                            <span className="scoreboard-winner__label">
                            WINNER
                        </span>

                            <strong className="scoreboard-winner__team">
                                {
                                    transition.teamName
                                }
                            </strong>

                            <span className="scoreboard-winner__score">
                            {
                                transition.score
                            }{" "}
                                PTS
                        </span>

                            <span className="scoreboard-winner__message">
                            {
                                transition.teamName
                            }{" "}
                                WINS ROUND{" "}
                                {
                                    transition.roundNumber
                                }!
                        </span>

                        </div>

                    </div>

                )}

            {/* ===============================================
                MAIN SCOREBOARD
                =============================================== */}

            <div className="scoreboard__hero">

                <div className="scoreboard__live">

                    <span className="scoreboard__live-dot" />

                    LIVE SCOREBOARD

                </div>

                <h1 className="scoreboard__title">
                    Friends Like These
                </h1>

                <div
                    className="scoreboard__colour-bar"
                    aria-hidden="true"
                >

                    <span className="scoreboard__colour-block scoreboard__colour-block--orange" />

                    <span className="scoreboard__colour-block scoreboard__colour-block--red" />

                    <span className="scoreboard__colour-block scoreboard__colour-block--purple" />

                    <span className="scoreboard__colour-block scoreboard__colour-block--blue" />

                    <span className="scoreboard__colour-block scoreboard__colour-block--teal" />

                </div>

                <div className="scoreboard__campuskey">

                    <span className="scoreboard__campuskey-name">
                        CampusKey
                    </span>

                    <span className="scoreboard__campuskey-edition">
                        EDITION
                    </span>

                </div>

                <p className="scoreboard__message">

                    {activeRound
                        ? `ROUND ${activeRound.roundNumber} OF ${rounds.length}`
                        : "OVERALL STANDINGS"}

                </p>

            </div>

            <div
                className={
                    `scoreboard__content ${
                        revealOverallStandings &&
                        !activeRound
                            ? "scoreboard__content--overall-reveal"
                            : ""
                    }`
                }
            >

                <h2>

                    {activeRound
                        ? `Round ${activeRound.roundNumber} Standings`
                        : "Overall Standings"}

                </h2>

                {/*
                 * The key changes only after a completed round.
                 *
                 * This forces one fresh TeamList mount for the
                 * reveal animation without allowing polling to
                 * restart it every second.
                 */}
                <TeamList
                    key={
                        activeRound
                            ? `round-${activeRound.roundNumber}`
                            : `overall-${overallRevealKey}`
                    }
                    teams={
                        displayedTeams
                    }
                    revealSequence={
                        revealOverallStandings &&
                        !activeRound
                    }
                />

            </div>

            <div className="scoreboard__tools">

                <Countdown
                    deadline={
                        registrationDeadline
                    }
                />

                <RegistrationQR
                    formUrl={
                        registrationFormUrl ||
                        eventConfig.registrationFormUrl
                    }
                />

            </div>

        </section>
    );
}

export default Scoreboard;