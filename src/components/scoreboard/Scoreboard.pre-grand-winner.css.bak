.scoreboard {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 2rem;
}

.scoreboard__hero {
    margin-bottom: 2rem;
    text-align: center;
}

.scoreboard__live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1rem;

    color: #ef4444;

    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
}

.scoreboard__live-dot {
    width: 9px;
    height: 9px;

    border-radius: 50%;

    background: #ef4444;

    animation:
            livePulse 1.6s ease-in-out infinite;
}

.scoreboard__title {
    margin: 0;

    color: #0b1f3a;

    font-size: clamp(2.8rem, 6vw, 5.4rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
}

.scoreboard__colour-bar {
    display: flex;

    width: min(520px, 72%);
    height: 10px;

    margin: 1rem auto 1.2rem;

    overflow: hidden;
}

.scoreboard__colour-block {
    flex: 1;
}

.scoreboard__colour-block--orange {
    background: #f59e0b;
}

.scoreboard__colour-block--red {
    background: #ef3340;
}

.scoreboard__colour-block--purple {
    background: #4f46a5;
}

.scoreboard__colour-block--blue {
    background: #2589c9;
}

.scoreboard__colour-block--teal {
    background: #10a8a5;
}

.scoreboard__campuskey {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.scoreboard__campuskey-name {
    color: #52657a;

    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 300;
    letter-spacing: -0.04em;
}

.scoreboard__campuskey-edition {
    margin-top: 0.15rem;

    color: #52657a;

    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.38em;
}

.scoreboard__message {
    margin: 0.55rem 0 0;

    color: #52657a;

    font-size: 1rem;
    font-weight: 700;
}

.scoreboard__content {
    width: 100%;
}

.scoreboard__tools {
    display: grid;
    grid-template-columns:
        minmax(280px, 0.8fr)
        minmax(360px, 1.2fr);

    gap: 1rem;

    margin-top: 1.5rem;
}


/* =========================================================
   LIVE INDICATOR
   ========================================================= */

@keyframes livePulse {

    0%,
    100% {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: 0.35;
        transform: scale(0.75);
    }
}


/* =========================================================
   FRIENDS LIKE THESE — ROUND TRANSITIONS
   ========================================================= */

.scoreboard-transition {
    position: fixed;
    inset: 0;

    z-index: 9999;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background: #0b1f3a;

    animation:
            scoreboardTransitionEnter
            0.45s
            ease-out
            both,

            scoreboardTransitionExit
            0.45s
            ease-in
            1.75s
            both;
}


/* ---------------------------------------------------------
   Subtle background energy
   --------------------------------------------------------- */

.scoreboard-transition::before {
    content: "";

    position: absolute;
    inset: -30%;

    background:
            radial-gradient(
                    circle at center,
                    rgba(255, 255, 255, 0.08),
                    transparent 55%
            );

    transform: scale(0.7);

    animation:
            scoreboardTransitionGlow
            1.4s
            ease-out
            both;

    pointer-events: none;
}


/* ---------------------------------------------------------
   Transition content
   --------------------------------------------------------- */

.scoreboard-transition__content {
    position: relative;

    z-index: 2;

    display: flex;
    flex-direction: column;
    align-items: center;

    padding: 2rem;

    text-align: center;

    animation:
            scoreboardTransitionContent
            0.6s
            ease-out
            both;
}

.scoreboard-transition__eyebrow {
    margin-bottom: 1rem;

    color: rgba(255, 255, 255, 0.75);

    font-size: clamp(0.8rem, 1.5vw, 1rem);
    font-weight: 800;

    letter-spacing: 0.25em;
    text-transform: uppercase;
}

.scoreboard-transition__round {
    color: #ffffff;

    font-size: clamp(4rem, 12vw, 9rem);
    font-weight: 900;

    letter-spacing: -0.04em;
    line-height: 0.95;

    text-shadow:
            0 12px 30px
            rgba(0, 0, 0, 0.22);
}

.scoreboard-transition__status {
    margin-top: 1.25rem;

    color: #ffffff;

    font-size: clamp(1rem, 3vw, 1.7rem);
    font-weight: 800;

    letter-spacing: 0.18em;
}


/* =========================================================
   FRIENDS LIKE THESE COLOUR SWEEP
   ========================================================= */

.scoreboard-transition__colour-bar {
    position: absolute;

    left: 0;
    right: 0;
    bottom: 0;

    display: grid;
    grid-template-columns:
        repeat(5, 1fr);

    height: 14px;

    transform-origin: left center;

    animation:
            scoreboardColourBarRise
            0.6s
            ease-out
            both;
}

.scoreboard-transition__colour-bar span {
    transform-origin: bottom center;

    animation:
            scoreboardColourBlockPulse
            0.65s
            ease-out
            both;
}

.scoreboard-transition__colour-bar
span:nth-child(1) {
    background: #f59e0b;
}

.scoreboard-transition__colour-bar
span:nth-child(2) {
    background: #ef3340;

    animation-delay: 60ms;
}

.scoreboard-transition__colour-bar
span:nth-child(3) {
    background: #4f46a5;

    animation-delay: 120ms;
}

.scoreboard-transition__colour-bar
span:nth-child(4) {
    background: #2589c9;

    animation-delay: 180ms;
}

.scoreboard-transition__colour-bar
span:nth-child(5) {
    background: #10a8a5;

    animation-delay: 240ms;
}


/* =========================================================
   START ROUND
   ========================================================= */

.scoreboard-transition--start
.scoreboard-transition__status {
    color: #10a8a5;
}

.scoreboard-transition--start
.scoreboard-transition__round {
    animation:
            scoreboardStartRound
            0.65s
            cubic-bezier(0.22, 1, 0.36, 1)
            both;
}


/* =========================================================
   ROUND COMPLETE
   ========================================================= */

.scoreboard-transition--complete {
    background:
            radial-gradient(
                    circle at center,
                    #15304f 0%,
                    #0b1f3a 58%,
                    #071629 100%
            );

    animation:
            scoreboardTransitionEnter
            0.45s
            ease-out
            both,

            scoreboardCompleteExit
            0.45s
            ease-in
            1.75s
            both;
}

.scoreboard-transition--complete
.scoreboard-transition__round {
    animation:
            scoreboardCompleteRound
            0.7s
            cubic-bezier(0.22, 1, 0.36, 1)
            both;
}

.scoreboard-transition--complete
.scoreboard-transition__status {
    color: #f59e0b;

    animation:
            scoreboardCompleteStatus
            0.65s
            ease-out
            0.2s
            both;
}


/* =========================================================
   TRANSITION ANIMATIONS
   ========================================================= */

@keyframes scoreboardTransitionEnter {

    from {
        opacity: 0;
        transform: scale(1.04);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

@keyframes scoreboardTransitionExit {

    from {
        opacity: 1;
        transform: scale(1);
    }

    to {
        opacity: 0;
        transform: scale(0.98);
    }
}

@keyframes scoreboardCompleteExit {

    from {
        opacity: 1;
        transform: scale(1);
    }

    to {
        opacity: 0;
        transform: scale(1.025);
    }
}

@keyframes scoreboardTransitionContent {

    from {
        opacity: 0;

        transform:
                translateY(28px);
    }

    to {
        opacity: 1;

        transform:
                translateY(0);
    }
}

@keyframes scoreboardTransitionGlow {

    from {
        opacity: 0;
        transform: scale(0.65);
    }

    45% {
        opacity: 1;
    }

    to {
        opacity: 0.4;
        transform: scale(1.1);
    }
}

@keyframes scoreboardColourBarRise {

    from {
        transform: scaleX(0);
    }

    to {
        transform: scaleX(1);
    }
}

@keyframes scoreboardColourBlockPulse {

    from {
        opacity: 0;

        transform:
                scaleY(0);
    }

    to {
        opacity: 1;

        transform:
                scaleY(1);
    }
}

@keyframes scoreboardStartRound {

    from {
        opacity: 0;

        transform:
                translateY(25px)
                scale(0.9);
    }

    to {
        opacity: 1;

        transform:
                translateY(0)
                scale(1);
    }
}

@keyframes scoreboardCompleteRound {

    0% {
        opacity: 0;

        transform:
                scale(0.75);
    }

    65% {
        opacity: 1;

        transform:
                scale(1.06);
    }

    100% {
        opacity: 1;

        transform:
                scale(1);
    }
}

@keyframes scoreboardCompleteStatus {

    from {
        opacity: 0;

        transform:
                translateY(12px);
    }

    to {
        opacity: 1;

        transform:
                translateY(0);
    }
}


/* =========================================================
   TABLET / MOBILE
   ========================================================= */

@media (max-width: 800px) {

    .scoreboard__tools {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {

    .scoreboard {
        padding: 1rem;
    }

    .scoreboard__colour-bar {
        width: 88%;
        height: 8px;
    }

    .scoreboard__campuskey-edition {
        font-size: 0.78rem;
        letter-spacing: 0.28em;
    }

    .scoreboard__message {
        font-size: 0.9rem;
    }

    .scoreboard-transition__content {
        padding: 1rem;
    }

    .scoreboard-transition__round {
        font-size:
                clamp(
                        3.6rem,
                        19vw,
                        6rem
                );
    }

    .scoreboard-transition__status {
        font-size: 0.95rem;
        letter-spacing: 0.12em;
    }

    .scoreboard-transition__colour-bar {
        height: 10px;
    }
}


/* =========================================================
   ACCESSIBILITY
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    .scoreboard__live-dot,
    .scoreboard-transition,
    .scoreboard-transition::before,
    .scoreboard-transition__content,
    .scoreboard-transition__round,
    .scoreboard-transition__status,
    .scoreboard-transition__colour-bar,
    .scoreboard-transition__colour-bar span {
        animation-duration: 0.01ms;
        animation-delay: 0ms;
    }
}

/* =========================================================
   ROUND WINNER CELEBRATION
   ========================================================= */

.scoreboard-transition--winner {
    background:
            radial-gradient(
                    circle at 50% 42%,
                    #17395d 0%,
                    #0b1f3a 52%,
                    #061425 100%
            );

    animation:
            scoreboardWinnerEnter 0.45s ease-out both,
            scoreboardWinnerExit 0.55s ease-in 3.05s both;
}


/* ---------------------------------------------------------
   Winner content
   --------------------------------------------------------- */

.scoreboard-winner {
    width: min(900px, 92vw);

    animation:
            scoreboardWinnerContent
            0.65s
            cubic-bezier(0.22, 1, 0.36, 1)
            both;
}

.scoreboard-winner__round {
    color: rgba(255, 255, 255, 0.72);

    font-size:
            clamp(
                    1rem,
                    2vw,
                    1.4rem
            );

    font-weight: 900;

    letter-spacing: 0.24em;

    text-transform: uppercase;

    animation:
            winnerRoundEnter
            0.5s
            ease-out
            both;
}

.scoreboard-winner__label {
    margin-top: 0.6rem;

    color: #f59e0b;

    font-size:
            clamp(
                    1.5rem,
                    4vw,
                    2.8rem
            );

    font-weight: 900;

    letter-spacing: 0.22em;

    text-transform: uppercase;

    animation:
            winnerLabelEnter
            0.6s
            cubic-bezier(0.22, 1, 0.36, 1)
            0.2s
            both;
}

.scoreboard-winner__team {
    display: block;

    max-width: 100%;

    margin-top: 0.6rem;

    color: #ffffff;

    font-size:
            clamp(
                    3.2rem,
                    10vw,
                    7.5rem
            );

    font-weight: 900;

    letter-spacing: -0.045em;

    line-height: 0.95;

    overflow-wrap: anywhere;

    text-shadow:
            0 10px 30px
            rgba(0, 0, 0, 0.28);

    animation:
            winnerTeamReveal
            0.8s
            cubic-bezier(0.22, 1, 0.36, 1)
            0.35s
            both;
}

.scoreboard-winner__score {
    margin-top: 1rem;

    color: #10a8a5;

    font-size:
            clamp(
                    1.2rem,
                    3vw,
                    2rem
            );

    font-weight: 900;

    letter-spacing: 0.12em;

    animation:
            winnerScoreReveal
            0.5s
            ease-out
            0.75s
            both;
}

.scoreboard-winner__message {
    margin-top: 1.2rem;

    padding:
            0.55rem
            1.15rem;

    color: #0b1f3a;
    background: #ffffff;

    border-radius: 999px;

    font-size:
            clamp(
                    0.8rem,
                    2vw,
                    1.1rem
            );

    font-weight: 900;

    letter-spacing: 0.08em;

    text-transform: uppercase;

    box-shadow:
            0 8px 24px
            rgba(0, 0, 0, 0.2);

    animation:
            winnerMessageReveal
            0.65s
            cubic-bezier(0.22, 1, 0.36, 1)
            1s
            both;
}


/* =========================================================
   CELEBRATION PARTICLES
   ========================================================= */

.scoreboard-winner__particles {
    position: absolute;
    inset: 0;

    z-index: 1;

    overflow: hidden;

    pointer-events: none;
}

.scoreboard-winner__particles span {
    position: absolute;

    top: -10%;

    width: 12px;
    height: 28px;

    opacity: 0;

    animation:
            winnerParticleFall
            2.5s
            cubic-bezier(0.15, 0.65, 0.35, 1)
            forwards;
}


/* Orange */

.scoreboard-winner__particles
span:nth-child(1) {
    left: 8%;
    background: #f59e0b;
    animation-delay: 0.15s;
}


/* Red */

.scoreboard-winner__particles
span:nth-child(2) {
    left: 18%;
    background: #ef3340;
    animation-delay: 0.4s;
}


/* Purple */

.scoreboard-winner__particles
span:nth-child(3) {
    left: 29%;
    background: #4f46a5;
    animation-delay: 0.1s;
}


/* Blue */

.scoreboard-winner__particles
span:nth-child(4) {
    left: 39%;
    background: #2589c9;
    animation-delay: 0.55s;
}


/* Teal */

.scoreboard-winner__particles
span:nth-child(5) {
    left: 48%;
    background: #10a8a5;
    animation-delay: 0.25s;
}


/* Orange */

.scoreboard-winner__particles
span:nth-child(6) {
    left: 58%;
    background: #f59e0b;
    animation-delay: 0.5s;
}


/* Red */

.scoreboard-winner__particles
span:nth-child(7) {
    left: 67%;
    background: #ef3340;
    animation-delay: 0.2s;
}


/* Purple */

.scoreboard-winner__particles
span:nth-child(8) {
    left: 76%;
    background: #4f46a5;
    animation-delay: 0.65s;
}


/* Blue */

.scoreboard-winner__particles
span:nth-child(9) {
    left: 86%;
    background: #2589c9;
    animation-delay: 0.3s;
}


/* Teal */

.scoreboard-winner__particles
span:nth-child(10) {
    left: 94%;
    background: #10a8a5;
    animation-delay: 0.05s;
}


/* =========================================================
   WINNER ANIMATIONS
   ========================================================= */

@keyframes scoreboardWinnerEnter {

    from {
        opacity: 0;

        transform:
                scale(1.08);
    }

    to {
        opacity: 1;

        transform:
                scale(1);
    }
}

@keyframes scoreboardWinnerExit {

    from {
        opacity: 1;

        transform:
                scale(1);
    }

    to {
        opacity: 0;

        transform:
                scale(1.04);
    }
}

@keyframes scoreboardWinnerContent {

    from {
        opacity: 0;

        transform:
                translateY(30px);
    }

    to {
        opacity: 1;

        transform:
                translateY(0);
    }
}

@keyframes winnerRoundEnter {

    from {
        opacity: 0;

        transform:
                translateY(-12px);
    }

    to {
        opacity: 1;

        transform:
                translateY(0);
    }
}

@keyframes winnerLabelEnter {

    from {
        opacity: 0;

        transform:
                scale(0.7);
    }

    70% {
        opacity: 1;

        transform:
                scale(1.1);
    }

    to {
        opacity: 1;

        transform:
                scale(1);
    }
}

@keyframes winnerTeamReveal {

    from {
        opacity: 0;

        transform:
                translateY(30px)
                scale(0.78);
    }

    65% {
        opacity: 1;

        transform:
                translateY(0)
                scale(1.06);
    }

    to {
        opacity: 1;

        transform:
                translateY(0)
                scale(1);
    }
}

@keyframes winnerScoreReveal {

    from {
        opacity: 0;

        transform:
                translateY(10px);
    }

    to {
        opacity: 1;

        transform:
                translateY(0);
    }
}

@keyframes winnerMessageReveal {

    from {
        opacity: 0;

        transform:
                translateY(18px)
                scale(0.85);
    }

    70% {
        opacity: 1;

        transform:
                translateY(0)
                scale(1.04);
    }

    to {
        opacity: 1;

        transform:
                translateY(0)
                scale(1);
    }
}

@keyframes winnerParticleFall {

    0% {
        opacity: 0;

        transform:
                translateY(-10vh)
                rotate(0deg);
    }

    12% {
        opacity: 1;
    }

    85% {
        opacity: 1;
    }

    100% {
        opacity: 0;

        transform:
                translateY(115vh)
                rotate(720deg);
    }
}


/* =========================================================
   MOBILE WINNER
   ========================================================= */

@media (max-width: 700px) {

    .scoreboard-winner__team {
        font-size:
                clamp(
                        2.8rem,
                        14vw,
                        5rem
                );
    }

    .scoreboard-winner__message {
        max-width: 90%;

        line-height: 1.35;
    }

    .scoreboard-winner__particles span {
        width: 9px;
        height: 22px;
    }
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    .scoreboard-transition--winner,
    .scoreboard-winner,
    .scoreboard-winner__round,
    .scoreboard-winner__label,
    .scoreboard-winner__team,
    .scoreboard-winner__score,
    .scoreboard-winner__message,
    .scoreboard-winner__particles span {
        animation-duration: 0.01ms;
        animation-delay: 0ms;
    }
}

/* =========================================================
   ROUND WINNER TROPHY
   ========================================================= */

.scoreboard-winner__trophy {
    position: relative;

    width: clamp(180px, 22vw, 300px);
    height: clamp(180px, 22vw, 300px);

    margin:
            0.25rem
            auto
            -0.25rem;

    filter:
            drop-shadow(
                    0 18px 30px
                    rgba(0, 0, 0, 0.32)
            );

    animation:
            winnerTrophyReveal
            900ms
            cubic-bezier(0.22, 1, 0.36, 1)
            0.12s
            both;
}

.scoreboard-winner__trophy::before {
    content: "";

    position: absolute;

    inset: 15%;

    border-radius: 50%;

    background:
            rgba(245, 158, 11, 0.32);

    filter: blur(24px);

    z-index: -1;

    animation:
            winnerTrophyGlow
            1.2s
            ease-in-out
            0.5s
            infinite
            alternate;
}

.scoreboard-winner__trophy svg {
    width: 100%;
    height: 100%;

    overflow: visible;
}

.scoreboard-winner__trophy-cup,
.scoreboard-winner__trophy-base {
    fill: #f59e0b;
}

.scoreboard-winner__trophy-handle {
    fill: none;

    stroke: #f59e0b;
    stroke-width: 8;

    stroke-linecap: round;
    stroke-linejoin: round;
}

@keyframes winnerTrophyReveal {

    0% {
        opacity: 0;

        transform:
                translateY(-35px)
                scale(0.3)
                rotate(-12deg);
    }

    55% {
        opacity: 1;

        transform:
                translateY(4px)
                scale(1.18)
                rotate(4deg);
    }

    75% {
        transform:
                translateY(-3px)
                scale(0.96)
                rotate(-2deg);
    }

    100% {
        opacity: 1;

        transform:
                translateY(0)
                scale(1)
                rotate(0);
    }
}

@keyframes winnerTrophyGlow {

    from {
        opacity: 0.45;

        transform:
                scale(0.85);
    }

    to {
        opacity: 1;

        transform:
                scale(1.3);
    }
}

@media (prefers-reduced-motion: reduce) {

    .scoreboard-winner__trophy,
    .scoreboard-winner__trophy::before {
        animation-duration: 0.01ms;
        animation-delay: 0ms;
    }
}


/* =========================================================
   OVERALL STANDINGS REVEAL
   ========================================================= */

.team-card--reveal {
    opacity: 0;

    animation:
            standingsCardReveal
            650ms
            cubic-bezier(0.22, 1, 0.36, 1)
            forwards;
}

@keyframes standingsCardReveal {

    0% {
        opacity: 0;

        transform:
                translateY(30px)
                scale(0.97);
    }

    65% {
        opacity: 1;

        transform:
                translateY(-3px)
                scale(1.01);
    }

    100% {
        opacity: 1;

        transform:
                translateY(0)
                scale(1);
    }
}

@media (prefers-reduced-motion: reduce) {

    .team-card--reveal {
        opacity: 1;

        animation-duration: 0.01ms;
        animation-delay: 0ms !important;
    }
}