import {
    useEffect,
    useRef,
    useState,
} from "react";

import type { Team } from "../../models/Team";
import "./TeamCard.css";
import MedalBadge from "./MedalBadge";

interface TeamCardProps {
    team: Team;
    rank: number;
}

function TeamCard({
                      team,
                      rank,
                  }: TeamCardProps) {

    /*
     * ---------------------------------------------------------
     * Ranking
     * ---------------------------------------------------------
     */

    const isTopThree =
        rank <= 3;

    const rankClass =
        rank === 1
            ? "team-card--first"
            : rank === 2
                ? "team-card--second"
                : rank === 3
                    ? "team-card--third"
                    : "";

    /*
     * ---------------------------------------------------------
     * Live score animation state
     * ---------------------------------------------------------
     */

    const previousScoreRef =
        useRef<number>(team.score);

    const [displayScore, setDisplayScore] =
        useState<number>(team.score);

    const [scoreChange, setScoreChange] =
        useState<number | null>(null);

    const [scoreChanged, setScoreChanged] =
        useState(false);

    /*
     * ---------------------------------------------------------
     * Detect score changes
     * ---------------------------------------------------------
     */

    useEffect(() => {

        const previousScore =
            previousScoreRef.current;

        const nextScore =
            team.score;

        const difference =
            nextScore - previousScore;

        /*
         * Polling will frequently return the same score.
         * In that case there is nothing to animate.
         */
        if (difference === 0) {

            setDisplayScore(nextScore);

            return;
        }

        /*
         * Store the new authoritative score so the next
         * update can be compared against it.
         */
        previousScoreRef.current =
            nextScore;

        /*
         * Show the +10 / -5 style indicator and activate
         * the temporary card highlight.
         */
        setScoreChange(difference);
        setScoreChanged(true);

        /*
         * -----------------------------------------------------
         * Animated score counter
         * -----------------------------------------------------
         */

        const animationDuration =
            450;

        const animationStart =
            performance.now();

        let animationFrame = 0;

        const animateScore = (
            currentTime: number
        ) => {

            const elapsed =
                currentTime - animationStart;

            const progress =
                Math.min(
                    elapsed / animationDuration,
                    1
                );

            /*
             * Ease-out curve.
             *
             * The score moves quickly at first and settles
             * smoothly onto the final value.
             */
            const easedProgress =
                1 -
                Math.pow(
                    1 - progress,
                    3
                );

            const animatedScore =
                Math.round(
                    previousScore +
                    (
                        nextScore -
                        previousScore
                    ) *
                    easedProgress
                );

            setDisplayScore(
                animatedScore
            );

            if (progress < 1) {

                animationFrame =
                    requestAnimationFrame(
                        animateScore
                    );

                return;
            }

            /*
             * Always finish on the exact server value.
             */
            setDisplayScore(
                nextScore
            );
        };

        animationFrame =
            requestAnimationFrame(
                animateScore
            );

        /*
         * Remove the temporary +points indicator and
         * card highlight after the feedback animation.
         */
        const feedbackTimer =
            window.setTimeout(
                () => {

                    setScoreChange(null);
                    setScoreChanged(false);

                },
                900
            );

        /*
         * Clean up if another score arrives while the
         * animation is still running or the card unmounts.
         */
        return () => {

            cancelAnimationFrame(
                animationFrame
            );

            window.clearTimeout(
                feedbackTimer
            );
        };

    }, [team.score]);

    /*
     * ---------------------------------------------------------
     * Render
     * ---------------------------------------------------------
     */

    return (
        <article
            className={
                `team-card ${rankClass} ${
                    scoreChanged
                        ? "team-card--score-changed"
                        : ""
                }`
            }
            data-team-id={team.id}
        >

            <div className="team-card__rank">

                {isTopThree ? (

                    <MedalBadge
                        rank={rank}
                    />

                ) : (

                    <span className="team-card__rank-number">
                        {rank}
                    </span>

                )}

            </div>

            <div className="team-card__content">

                <h2 className="team-card__name">
                    {team.name}
                </h2>

                <p className="team-card__members">
                    {team.members.join(" • ")}
                </p>

            </div>

            <div className="team-card__score">

                {scoreChange !== null && (

                    <span
                        className={
                            `team-card__score-change ${
                                scoreChange > 0
                                    ? "team-card__score-change--positive"
                                    : "team-card__score-change--negative"
                            }`
                        }
                        aria-hidden="true"
                    >
                        {scoreChange > 0
                            ? `+${scoreChange}`
                            : scoreChange}
                    </span>

                )}

                <span className="team-card__score-value">
                    {displayScore}
                </span>

                <span className="team-card__score-label">
                    pts
                </span>

            </div>

        </article>
    );
}

export default TeamCard;