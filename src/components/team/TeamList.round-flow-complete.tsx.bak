import {
    useEffect,
    useLayoutEffect,
    useMemo,
    useRef,
    useState,
} from "react";

import type { Team } from "../../models/Team";
import TeamCard from "./TeamCard";
import "./TeamList.css";

interface TeamListProps {
    teams: Team[];
    revealSequence?: boolean;
}

function TeamList({
                      teams,
                      revealSequence = false,
                  }: TeamListProps) {

    /*
     * ---------------------------------------------------------
     * Ranking
     * ---------------------------------------------------------
     */

    const sortedTeams = useMemo(
        () =>
            [...teams].sort(
                (a, b) => {

                    const scoreDifference =
                        b.score - a.score;

                    if (scoreDifference !== 0) {
                        return scoreDifference;
                    }

                    /*
                     * Stable tie-breaker.
                     *
                     * This prevents teams with equal scores
                     * from swapping positions because of
                     * one-second polling.
                     */
                    return a.id.localeCompare(
                        b.id
                    );
                }
            ),
        [teams]
    );

    /*
     * ---------------------------------------------------------
     * Stable leaderboard signature
     * ---------------------------------------------------------
     *
     * The API can return a new array every second.
     *
     * We only want animation logic to react when the actual
     * ranking or score changes.
     */

    const leaderboardSignature =
        useMemo(
            () =>
                sortedTeams
                    .map(
                        (team, index) =>
                            `${index}:${team.id}:${team.score}`
                    )
                    .join("|"),
            [sortedTeams]
        );

    /*
     * ---------------------------------------------------------
     * DOM references for rank movement
     * ---------------------------------------------------------
     */

    const listRef =
        useRef<HTMLElement | null>(
            null
        );

    const previousPositions =
        useRef<Map<string, number>>(
            new Map()
        );

    const hasMeasuredPositions =
        useRef(false);

    /*
     * ---------------------------------------------------------
     * Leader tracking
     * ---------------------------------------------------------
     */

    const previousLeaderId =
        useRef<
            string | null | undefined
        >(undefined);

    const [
        newLeaderId,
        setNewLeaderId,
    ] = useState<string | null>(
        null
    );

    /*
     * ---------------------------------------------------------
     * Detect a genuine new leader
     * ---------------------------------------------------------
     */

    useEffect(() => {

        const currentLeaderId =
            sortedTeams[0]?.id ??
            null;

        /*
         * Initial load.
         *
         * Establish the current leader without triggering
         * NEW LEADER.
         */
        if (
            previousLeaderId.current ===
            undefined
        ) {

            previousLeaderId.current =
                currentLeaderId;

            return;
        }

        const oldLeaderId =
            previousLeaderId.current;

        /*
         * Remember the new state immediately.
         */
        previousLeaderId.current =
            currentLeaderId;

        /*
         * No current leader.
         */
        if (
            currentLeaderId === null
        ) {

            setNewLeaderId(null);

            return;
        }

        /*
         * Same leader.
         *
         * This is what normally happens during the
         * one-second polling cycle.
         */
        if (
            oldLeaderId ===
            currentLeaderId
        ) {
            return;
        }

        /*
         * If the leaderboard has only just appeared,
         * don't call the first team a new leader.
         */
        if (
            oldLeaderId === null
        ) {
            return;
        }

        /*
         * Don't show NEW LEADER while the Overall
         * Standings reveal is taking place.
         */
        if (revealSequence) {
            return;
        }

        /*
         * Genuine takeover.
         */
        setNewLeaderId(
            currentLeaderId
        );

        const timer =
            window.setTimeout(
                () => {

                    setNewLeaderId(
                        null
                    );

                },
                1600
            );

        return () => {

            window.clearTimeout(
                timer
            );
        };

    }, [
        leaderboardSignature,
        revealSequence,
        sortedTeams,
    ]);

    /*
     * ---------------------------------------------------------
     * Physical rank movement
     * ---------------------------------------------------------
     */

    useLayoutEffect(() => {

        const list =
            listRef.current;

        if (!list) {
            return;
        }

        const cards =
            Array.from(
                list.querySelectorAll<HTMLElement>(
                    "[data-team-id]"
                )
            );

        const nextPositions =
            new Map<string, number>();

        /*
         * Measure the current physical position of every
         * team card.
         */
        cards.forEach(
            (card) => {

                const teamId =
                    card.dataset.teamId;

                if (!teamId) {
                    return;
                }

                nextPositions.set(
                    teamId,
                    card.getBoundingClientRect().top
                );
            }
        );

        /*
         * Initial render.
         *
         * Store positions without animating anything.
         */
        if (
            !hasMeasuredPositions.current
        ) {

            previousPositions.current =
                nextPositions;

            hasMeasuredPositions.current =
                true;

            return;
        }

        /*
         * During Overall Standings reveal, TeamCard handles
         * its own entrance animation.
         *
         * Running the FLIP rank animation at the same time
         * would cause visual jumping.
         */
        if (revealSequence) {

            previousPositions.current =
                nextPositions;

            return;
        }

        /*
         * Compare old and new positions.
         */
        cards.forEach(
            (card) => {

                const teamId =
                    card.dataset.teamId;

                if (!teamId) {
                    return;
                }

                const previousTop =
                    previousPositions.current.get(
                        teamId
                    );

                const currentTop =
                    nextPositions.get(
                        teamId
                    );

                if (
                    previousTop === undefined ||
                    currentTop === undefined
                ) {
                    return;
                }

                const movement =
                    previousTop -
                    currentTop;

                /*
                 * Team hasn't changed physical position.
                 *
                 * Normal polling ends here.
                 */
                if (
                    Math.abs(movement) < 1
                ) {
                    return;
                }

                /*
                 * FLIP animation.
                 *
                 * The DOM is already in the new order.
                 * Temporarily position the card where it used
                 * to be and animate it into the new position.
                 */
                card.animate(
                    [
                        {
                            transform:
                                `translateY(${movement}px)`,
                        },
                        {
                            transform:
                                "translateY(0)",
                        },
                    ],
                    {
                        duration: 550,
                        easing:
                            "cubic-bezier(0.22, 1, 0.36, 1)",
                        fill: "both",
                    }
                );
            }
        );

        /*
         * Current positions become the baseline for the
         * next real ranking change.
         */
        previousPositions.current =
            nextPositions;

    }, [
        leaderboardSignature,
        revealSequence,
    ]);

    /*
     * ---------------------------------------------------------
     * Render
     * ---------------------------------------------------------
     */

    return (
        <section
            ref={listRef}
            className={
                [
                    "team-list",

                    revealSequence
                        ? "team-list--reveal"
                        : "",
                ]
                    .filter(Boolean)
                    .join(" ")
            }
        >

            {sortedTeams.length === 0 && (

                <p className="team-list__empty">
                    No teams have registered yet.
                </p>

            )}

            {sortedTeams.map(
                (team, index) => (

                    <TeamCard
                        key={team.id}
                        team={team}
                        rank={index + 1}
                        isNewLeader={
                            team.id ===
                            newLeaderId
                        }
                        revealDelay={
                            revealSequence
                                ? index * 180
                                : undefined
                        }
                    />

                )
            )}

        </section>
    );
}

export default TeamList;