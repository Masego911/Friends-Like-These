.team-card {
    display: flex; /* Main card layout. */
    align-items: center;
    gap: 1rem;
    width: 100%;
    min-height: 86px;
    padding: 0.8rem 1.25rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    box-sizing: border-box;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);
}

.team-card__rank {
    display: flex; /* Holds the medal or normal rank. */
    align-items: center;
    justify-content: center;
    width: 76px;
    flex-shrink: 0;
}

.medal-badge {
    width: 68px;
    height: 78px;
    overflow: visible;
    filter: drop-shadow(0 3px 4px rgba(15, 23, 42, 0.22));
}

.medal-badge__number {
    fill: #10233f;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 34px;
    font-weight: 900;
    dominant-baseline: middle;
    paint-order: stroke;
    stroke: rgba(255, 255, 255, 0.5);
    stroke-width: 1.5px;
}

.team-card__rank-number {
    display: flex; /* Standard rank for position 4 onwards. */
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: #eef1f4;
    border-radius: 50%;
    color: #334155;
    font-size: 1rem;
    font-weight: 800;
}

.team-card__content {
    flex: 1;
    min-width: 0;
}

.team-card__name {
    margin: 0;
    color: #0b1f3a;
    font-size: 1.1rem;
    font-weight: 800;
}

.team-card__members {
    margin: 0.3rem 0 0;
    overflow: hidden;
    color: #6b7280;
    font-size: 0.85rem;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.team-card__score {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 70px;
    flex-shrink: 0;
}

.team-card__score-value {
    color: #00aeb5;
    font-size: 1.8rem;
    font-weight: 900;
    line-height: 1;
}

.team-card__score-label {
    margin-top: 0.2rem;
    color: #9ca3af;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
}

@media (max-width: 600px) {
    .team-card {
        gap: 0.7rem;
        padding: 0.75rem;
    }

    .team-card__rank {
        width: 58px;
    }

    .medal-badge {
        width: 56px;
        height: 66px;
    }

    .team-card__name {
        font-size: 1rem;
    }

    .team-card__members {
        font-size: 0.75rem;
    }

    .team-card__score {
        min-width: 50px;
    }

    .team-card__score-value {
        font-size: 1.5rem;
    }
}

/* ---------------------------------------------------------
   Live scoring feedback
   --------------------------------------------------------- */

.team-card {
    position: relative;
    transition:
            border-color 300ms ease,
            box-shadow 300ms ease,
            background-color 300ms ease;
}

.team-card--score-changed {
    border-color: rgba(0, 174, 181, 0.55);
    background-color: #f4ffff;
    box-shadow:
            0 8px 24px rgba(0, 174, 181, 0.16);
}

.team-card__score {
    position: relative;
}

.team-card__score-value {
    font-variant-numeric: tabular-nums;
}

.team-card__score-change {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.25rem);

    font-size: 0.85rem;
    font-weight: 900;
    line-height: 1;

    pointer-events: none;

    animation:
            teamScoreChange 900ms ease-out forwards;
}

.team-card__score-change--positive {
    color: #00aeb5;
}

.team-card__score-change--negative {
    color: #ef3340;
}

@keyframes teamScoreChange {

    0% {
        opacity: 0;
        transform:
                translateY(8px)
                scale(0.85);
    }

    20% {
        opacity: 1;
        transform:
                translateY(0)
                scale(1.08);
    }

    70% {
        opacity: 1;
        transform:
                translateY(-8px)
                scale(1);
    }

    100% {
        opacity: 0;
        transform:
                translateY(-16px)
                scale(0.95);
    }
}

@media (prefers-reduced-motion: reduce) {

    .team-card {
        transition: none;
    }

    .team-card__score-change {
        animation: none;
    }
}

/* =========================================================
   OVERALL STANDINGS REVEAL
   ========================================================= */

.team-card--reveal {
    opacity: 0;

    animation:
            standingsCardReveal
            650ms
            cubic-bezier(0.22, 1, 0.36, 1)
            forwards;
}

@keyframes standingsCardReveal {

    0% {
        opacity: 0;

        transform:
                translateY(32px)
                scale(0.96);
    }

    65% {
        opacity: 1;

        transform:
                translateY(-4px)
                scale(1.01);
    }

    100% {
        opacity: 1;

        transform:
                translateY(0)
                scale(1);
    }
}

@media (prefers-reduced-motion: reduce) {

    .team-card--reveal {
        opacity: 1;

        animation-duration: 0.01ms;

        animation-delay:
                0ms !important;
    }
}