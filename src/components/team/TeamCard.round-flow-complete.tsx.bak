import {
    useEffect,
    useRef,
    useState,
} from "react";

import type { Team } from "../../models/Team";
import "./TeamCard.css";
import MedalBadge from "./MedalBadge";

interface TeamCardProps {
    team: Team;
    rank: number;
    isNewLeader?: boolean;

    /*
     * Used only for the Overall Standings reveal.
     *
     * Example:
     * 1st = 0ms
     * 2nd = 180ms
     * 3rd = 360ms
     */
    revealDelay?: number;
}

function TeamCard({
                      team,
                      rank,
                      isNewLeader = false,
                      revealDelay,
                  }: TeamCardProps) {

    /*
     * ---------------------------------------------------------
     * Ranking
     * ---------------------------------------------------------
     */

    const isTopThree =
        rank <= 3;

    const rankClass =
        rank === 1
            ? "team-card--first"
            : rank === 2
                ? "team-card--second"
                : rank === 3
                    ? "team-card--third"
                    : "";

    /*
     * ---------------------------------------------------------
     * Score animation
     * ---------------------------------------------------------
     */

    const previousScoreRef =
        useRef<number>(
            team.score
        );

    const [
        displayScore,
        setDisplayScore,
    ] = useState<number>(
        team.score
    );

    const [
        scoreChange,
        setScoreChange,
    ] = useState<number | null>(
        null
    );

    const [
        scoreChanged,
        setScoreChanged,
    ] = useState(false);

    useEffect(() => {

        const previousScore =
            previousScoreRef.current;

        const nextScore =
            team.score;

        const difference =
            nextScore - previousScore;

        /*
         * Normal polling frequently returns the same score.
         *
         * Do not animate when nothing actually changed.
         */
        if (difference === 0) {

            setDisplayScore(
                nextScore
            );

            return;
        }

        previousScoreRef.current =
            nextScore;

        setScoreChange(
            difference
        );

        setScoreChanged(
            true
        );

        /*
         * -----------------------------------------------------
         * Animated score count
         * -----------------------------------------------------
         */

        const duration =
            450;

        const startTime =
            performance.now();

        let animationFrame =
            0;

        const animateScore = (
            currentTime: number
        ) => {

            const elapsed =
                currentTime -
                startTime;

            const progress =
                Math.min(
                    elapsed / duration,
                    1
                );

            /*
             * Ease-out cubic.
             */
            const easedProgress =
                1 -
                Math.pow(
                    1 - progress,
                    3
                );

            const animatedValue =
                Math.round(
                    previousScore +
                    (
                        nextScore -
                        previousScore
                    ) *
                    easedProgress
                );

            setDisplayScore(
                animatedValue
            );

            if (
                progress < 1
            ) {

                animationFrame =
                    requestAnimationFrame(
                        animateScore
                    );

                return;
            }

            setDisplayScore(
                nextScore
            );
        };

        animationFrame =
            requestAnimationFrame(
                animateScore
            );

        /*
         * Remove +10 / -5 and the score glow after the
         * score impact animation has completed.
         */
        const feedbackTimer =
            window.setTimeout(
                () => {

                    setScoreChange(
                        null
                    );

                    setScoreChanged(
                        false
                    );

                },
                900
            );

        return () => {

            cancelAnimationFrame(
                animationFrame
            );

            window.clearTimeout(
                feedbackTimer
            );
        };

    }, [team.score]);

    /*
     * ---------------------------------------------------------
     * Overall Standings reveal
     * ---------------------------------------------------------
     */

    const shouldReveal =
        revealDelay !== undefined;

    /*
     * ---------------------------------------------------------
     * Render
     * ---------------------------------------------------------
     */

    return (
        <article
            className={
                [
                    "team-card",

                    rankClass,

                    scoreChanged
                        ? "team-card--score-changed"
                        : "",

                    isNewLeader
                        ? "team-card--new-leader"
                        : "",

                    shouldReveal
                        ? "team-card--reveal"
                        : "",
                ]
                    .filter(Boolean)
                    .join(" ")
            }
            data-team-id={team.id}
            style={
                shouldReveal
                    ? {
                        animationDelay:
                            `${revealDelay}ms`,
                    }
                    : undefined
            }
        >

            {/* ===============================================
                NEW LEADER
                =============================================== */}

            {isNewLeader && (

                <div
                    className="team-card__leader-banner"
                    role="status"
                    aria-live="polite"
                >

                    <span
                        className="team-card__leader-star"
                        aria-hidden="true"
                    >
                        ★
                    </span>

                    <span>
                        NEW LEADER
                    </span>

                    <span
                        className="team-card__leader-star"
                        aria-hidden="true"
                    >
                        ★
                    </span>

                </div>

            )}

            {/* ===============================================
                RANK
                =============================================== */}

            <div className="team-card__rank">

                {isTopThree ? (

                    <MedalBadge
                        rank={rank}
                    />

                ) : (

                    <span className="team-card__rank-number">
                        {rank}
                    </span>

                )}

            </div>

            {/* ===============================================
                TEAM
                =============================================== */}

            <div className="team-card__content">

                <h2 className="team-card__name">
                    {team.name}
                </h2>

                {team.members.length > 0 && (

                    <p className="team-card__members">
                        {team.members.join(" • ")}
                    </p>

                )}

            </div>

            {/* ===============================================
                SCORE
                =============================================== */}

            <div className="team-card__score">

                {scoreChange !== null && (

                    <span
                        className={
                            [
                                "team-card__score-change",

                                scoreChange > 0
                                    ? "team-card__score-change--positive"
                                    : "team-card__score-change--negative",
                            ].join(" ")
                        }
                        aria-hidden="true"
                    >
                        {scoreChange > 0
                            ? `+${scoreChange}`
                            : scoreChange}
                    </span>

                )}

                <span className="team-card__score-value">
                    {displayScore}
                </span>

                <span className="team-card__score-label">
                    pts
                </span>

            </div>

        </article>
    );
}

export default TeamCard;