# 16. PostgreSQL Schema

The initial PostgreSQL schema can be implemented as follows.

## Events

    CREATE TABLE events (
        event_id BIGSERIAL PRIMARY KEY,
        name VARCHAR(150) NOT NULL,
        description VARCHAR(500),
        event_date TIMESTAMP,
        status VARCHAR(30) NOT NULL DEFAULT 'DRAFT',
        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
    );

## Event Settings

    CREATE TABLE event_settings (
        event_settings_id BIGSERIAL PRIMARY KEY,
        event_id BIGINT NOT NULL UNIQUE,
        registration_deadline TIMESTAMP,
        registration_url VARCHAR(500),
        max_team_members INTEGER NOT NULL DEFAULT 6,

        CONSTRAINT fk_event_settings_event
            FOREIGN KEY (event_id)
            REFERENCES events(event_id)
            ON DELETE CASCADE,

        CONSTRAINT chk_max_team_members
            CHECK (max_team_members > 0)
    );

## Teams

    CREATE TABLE teams (
        team_id BIGSERIAL PRIMARY KEY,
        event_id BIGINT NOT NULL,
        name VARCHAR(120) NOT NULL,
        score INTEGER NOT NULL DEFAULT 0,
        is_deleted BOOLEAN NOT NULL DEFAULT FALSE,
        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

        CONSTRAINT fk_team_event
            FOREIGN KEY (event_id)
            REFERENCES events(event_id)
            ON DELETE CASCADE,

        CONSTRAINT chk_team_score
            CHECK (score >= 0),

        CONSTRAINT uq_team_name_per_event
            UNIQUE (event_id, name)
    );

## Team Members

    CREATE TABLE team_members (
        team_member_id BIGSERIAL PRIMARY KEY,
        team_id BIGINT NOT NULL,
        full_name VARCHAR(150) NOT NULL,
        email VARCHAR(200),
        phone VARCHAR(30),
        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

        CONSTRAINT fk_team_member_team
            FOREIGN KEY (team_id)
            REFERENCES teams(team_id)
            ON DELETE CASCADE
    );

## Users

    CREATE TABLE users (
        user_id BIGSERIAL PRIMARY KEY,
        username VARCHAR(100) NOT NULL UNIQUE,
        email VARCHAR(200) NOT NULL UNIQUE,
        password_hash VARCHAR(255) NOT NULL,
        role VARCHAR(30) NOT NULL DEFAULT 'ADMIN',
        enabled BOOLEAN NOT NULL DEFAULT TRUE,
        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
    );

## Score Events

    CREATE TABLE score_events (
        score_event_id BIGSERIAL PRIMARY KEY,
        event_id BIGINT NOT NULL,
        team_id BIGINT NOT NULL,
        performed_by BIGINT,
        amount INTEGER NOT NULL,
        previous_score INTEGER NOT NULL,
        new_score INTEGER NOT NULL,
        reason VARCHAR(255) NOT NULL,
        event_type VARCHAR(30) NOT NULL DEFAULT 'ADJUSTMENT',
        created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

        CONSTRAINT fk_score_event_event
            FOREIGN KEY (event_id)
            REFERENCES events(event_id)
            ON DELETE CASCADE,

        CONSTRAINT fk_score_event_team
            FOREIGN KEY (team_id)
            REFERENCES teams(team_id)
            ON DELETE RESTRICT,

        CONSTRAINT fk_score_event_user
            FOREIGN KEY (performed_by)
            REFERENCES users(user_id)
            ON DELETE SET NULL,

        CONSTRAINT chk_previous_score
            CHECK (previous_score >= 0),

        CONSTRAINT chk_new_score
            CHECK (new_score >= 0)
    );

